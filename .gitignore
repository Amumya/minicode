# ---- 密钥与本地配置 ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- IDE / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 本机工具（便携 Redis 之类，二进制不入库） ----
.tools/

# ---- 上下文压缩落盘的工具输出（跑起来就有，不入库） ----
.minicode/

# ---- 前端 ----
node_modules/
web/.vite/
web/dist/

# ---- 运行时产物 ----
*.log
eval/tmp/
/runs/
.probe/

# pytest 的临时目录。没配 basetemp 时它会在当前目录下建一个，
# 不加这条就会把测试产生的小文件提交进去。
pytest-of-*/

# ---- pip 的临时构建目录 ----
# 网络不通时 pip 会在这里留半成品；实测它们曾被抓进提交，所以显式忽略
pip-*/

# 说明：eval/runs/ 必须入库 —— README 里引用的每个数字都要能在仓库里被复核。
# 所以上面写的是 /runs/（只挡仓库根目录那一个），不是 runs/。

# 测试/审查实验留下的临时目录
mc-*/
pytest-of-*/


# ---- 测试/工具留下的临时产物 ----
# pywin32 的 gen 缓存（实验打开资源管理器时生成过）、pytest 的输出重定向文件
minicode_gen/
gen_py/
pytest_*.txt


# ---- 不公开的个人/过程文档（放在仓库外的本地目录，别误提交） ----


# Python 的 mkdtemp 会生成 tmpXXXX 目录；这台机器 TEMP 指向仓库根，
# 测试里随手建的临时目录曾被抓进提交（里面是测试用的记忆文件）。
tmp*/
