# ---- 密钥与本地配置 ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- IDE / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 本机工具（便携 Redis 之类，二进制不入库） ----
.tools/

# ---- 运行时产物 ----
*.log
eval/tmp/
/runs/
.probe/

# pytest 的临时目录。没配 basetemp 时它会在当前目录下建一个，
# 不加这条就会把测试产生的小文件提交进去。
pytest-of-*/

# ---- pip 的临时构建目录 ----
# 网络不通时 pip 会在这里留半成品；实测它们曾被抓进提交，所以显式忽略
pip-*/

# 说明：eval/runs/ 必须入库 —— README 里引用的每个数字都要能在仓库里被复核。
# 所以上面写的是 /runs/（只挡仓库根目录那一个），不是 runs/。
