# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，永远不要提交。

# ---- 必需 ----
# API Key
DEEPSEEK_API_KEY=

# 模型服务地址
# 实测（2026-10-05）：https://api.deepseek.com/v1/messages 与 /messages 均返回 404，
# 只有 /anthropic 后缀说 Anthropic 协议。
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# 模型 ID
# 实测本 key 下 GET /models 只返回这两个：
#   deepseek-flash   快、便宜 —— 跑评测/消融实验默认用它
#   deepseek-v4-pro  强、贵   —— 只用于最终验证与演示
DEEPSEEK_MODEL=deepseek-flash

# ---- 运行控制 ----
# 单个任务最大工具调用轮数，防止死循环
MAX_STEPS=8
